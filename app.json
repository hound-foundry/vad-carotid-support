{
  "expo": {
    "name": "VAD & Carotid Support",
    "slug": "vad-carotid-support",
    "scheme": "vadcarotidsupport",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#edf5f3"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}

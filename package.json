{
  "name": "vad-carotid-support",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs && node scripts/validate-content.mjs && node scripts/validate-review.mjs",
    "build:web": "expo export --platform web",
    "release:web": "npm test && node scripts/assert-market-ready.mjs && expo export --platform web && node scripts/validate-export.mjs"
  },
  "dependencies": {
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~57.0.27",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
